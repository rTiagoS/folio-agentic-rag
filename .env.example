# Required: create a key at https://aistudio.google.com/api-keys
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Set the destination for YOUR workspace before enabling tracing.
LANGSMITH_TRACING=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID=
# Project-based workspace:
# LANGSMITH_PROJECT=
# Agent-based workspace (use instead of LANGSMITH_PROJECT):
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=local
